{
  // LocalLLM Portable — configuración remota (sincronizada vía Git y recargada en caliente).
  // Los perfiles se evalúan EN ORDEN: gana el primero cuyo "match" coincide Y cuyo modelo cabe en memoria
  // tras ajustar numParallel → numCtx. Si ninguno cabe, se pasa al siguiente perfil.
  "schemaVersion": 1,

  "gateway": {
    "listenAddress": "127.0.0.1",
    "port": 11434,
    "h2cPort": 11436,
    "ollamaPort": 11435,
    "maxQueuedRequests": 64,
    "queueTimeoutSeconds": 120,
    "keepAlive": "30m",
    "injectStreamUsage": true,
    "drainTimeoutSeconds": 60
  },

  "memoryGuard": {
    "enabled": true,
    "minFreeVramMb": 800,
    "minFreeRamMb": 2048,
    "recoveryFactor": 1.25,
    "pollIntervalMs": 1000,
    "retryAfterSeconds": 5,
    "vramReserveMb": 1024,
    "ramReserveMb": 6144
  },

  "git": {
    "enabled": true,
    "remote": "https://github.com/rmrodriguezgit/LLM-Portable.git",
    "branch": "main",
    "intervalMinutes": 15,
    "allowSelfRebuild": true,
    "healthCheckTimeoutSeconds": 10
  },

  "tools": {
    // "version": "latest" o un tag fijo. "sha256": hash fijado (opcional; si falta se usa el digest publicado por GitHub).
    "uv":     { "githubRepo": "astral-sh/uv",        "version": "latest", "assetPattern": "^uv-x86_64-pc-windows-msvc\\.zip$", "probeRelativePath": "uv.exe" },
    "ollama": { "githubRepo": "ollama/ollama",       "version": "latest", "assetPattern": "^ollama-windows-amd64\\.zip$",      "probeRelativePath": "ollama.exe" },
    "git":    { "githubRepo": "git-for-windows/git", "version": "latest", "assetPattern": "^MinGit-[0-9.]+(\\.windows\\.[0-9]+)?-64-bit\\.zip$", "probeRelativePath": "cmd\\git.exe", "preferSystemInstall": true },
    "dotnetChannel": "8.0"
  },

  // weightsGb: tamaño Q4_K_M aproximado. kvMbPer1kF16: KV cache por 1024 tokens en f16
  //   (= capas × kv_heads × head_dim × 2 (K,V) × 2 bytes × 1024). q8_0 = la mitad.
  "profiles": [
    {
      "id": "nvidia-20gb-plus",
      "description": "NVIDIA ≥ 20 GB (RTX 3090/4090, RTX 4000/5000 Ada)",
      "match": { "gpuVendor": "nvidia", "minVramMb": 19456 },
      "model":     { "name": "qwen3:30b-a3b",      "weightsGb": 18.6, "kvMbPer1kF16": 96,  "layers": 48 },
      "fallbacks": [
        { "name": "qwen2.5-coder:32b", "weightsGb": 19.9, "kvMbPer1kF16": 256, "layers": 64 },
        { "name": "qwen3:14b",         "weightsGb": 9.3,  "kvMbPer1kF16": 160, "layers": 40 }
      ],
      "numCtx": 16384, "minNumCtx": 8192, "numParallel": 4,
      "kvCacheType": "q8_0", "flashAttention": true
    },
    {
      "id": "nvidia-12-16gb",
      "description": "NVIDIA 12–16 GB (RTX 3060 12GB, 4070, 4080)",
      "match": { "gpuVendor": "nvidia", "minVramMb": 11264, "maxVramMb": 19455 },
      "model":     { "name": "qwen3:14b", "weightsGb": 9.3, "kvMbPer1kF16": 160, "layers": 40 },
      "fallbacks": [ { "name": "qwen3:8b", "weightsGb": 5.2, "kvMbPer1kF16": 144, "layers": 36 } ],
      "numCtx": 8192, "minNumCtx": 4096, "numParallel": 2,
      "kvCacheType": "q8_0", "flashAttention": true
    },
    {
      "id": "nvidia-6-8gb",
      "description": "NVIDIA 6–8 GB (RTX 2060/3060 Ti/4060)",
      "match": { "gpuVendor": "nvidia", "minVramMb": 5632, "maxVramMb": 11263 },
      "model":     { "name": "qwen3:8b", "weightsGb": 5.2, "kvMbPer1kF16": 144, "layers": 36 },
      "fallbacks": [
        { "name": "llama3.1:8b", "weightsGb": 4.9, "kvMbPer1kF16": 128, "layers": 32 },
        { "name": "qwen3:4b",    "weightsGb": 2.6, "kvMbPer1kF16": 144, "layers": 36 }
      ],
      "numCtx": 8192, "minNumCtx": 4096, "numParallel": 2,
      "kvCacheType": "q8_0", "flashAttention": true
    },
    {
      "id": "nvidia-small",
      "description": "NVIDIA < 6 GB",
      "match": { "gpuVendor": "nvidia", "minVramMb": 3500, "maxVramMb": 5631 },
      "model":     { "name": "qwen3:4b",    "weightsGb": 2.6, "kvMbPer1kF16": 144, "layers": 36 },
      "fallbacks": [ { "name": "llama3.2:3b", "weightsGb": 2.0, "kvMbPer1kF16": 112, "layers": 28 } ],
      "numCtx": 4096, "minNumCtx": 2048, "numParallel": 1,
      "kvCacheType": "q8_0", "flashAttention": true
    },
    {
      "id": "amd-rocm",
      "description": "AMD Radeon (ROCm) — num_gpu dinámico según VRAM dedicada (DXGI)",
      "match": { "gpuVendor": "amd", "minVramMb": 7680 },
      "model":     { "name": "qwen3:14b", "weightsGb": 9.3, "kvMbPer1kF16": 160, "layers": 40 },
      "fallbacks": [ { "name": "qwen3:8b", "weightsGb": 5.2, "kvMbPer1kF16": 144, "layers": 36 } ],
      "numCtx": 8192, "minNumCtx": 4096, "numParallel": 1,
      "kvCacheType": "q8_0", "flashAttention": true, "dynamicNumGpu": true
    },
    {
      "id": "cpu-32gb-plus",
      "description": "Solo CPU con ≥ 32 GB RAM (Core Ultra / Xeon / Ryzen)",
      "match": { "gpuVendor": "cpu", "minRamMb": 30000 },
      "model":     { "name": "qwen3:8b", "weightsGb": 5.2, "kvMbPer1kF16": 144, "layers": 36 },
      "fallbacks": [ { "name": "llama3.1:8b", "weightsGb": 4.9, "kvMbPer1kF16": 128, "layers": 32 } ],
      "numCtx": 8192, "minNumCtx": 4096, "numParallel": 2,
      "kvCacheType": "q8_0", "flashAttention": true
    },
    {
      "id": "cpu-small",
      "description": "Solo CPU con ≤ 16–24 GB RAM",
      "match": { "gpuVendor": "cpu" },
      "model":     { "name": "qwen3:4b", "weightsGb": 2.6, "kvMbPer1kF16": 144, "layers": 36 },
      "fallbacks": [
        { "name": "llama3.2:3b", "weightsGb": 2.0, "kvMbPer1kF16": 112, "layers": 28 },
        { "name": "qwen3:1.7b",  "weightsGb": 1.4, "kvMbPer1kF16": 112, "layers": 28 }
      ],
      "numCtx": 4096, "minNumCtx": 2048, "numParallel": 1,
      "kvCacheType": "q8_0", "flashAttention": true
    }
  ]
}
